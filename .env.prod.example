DJANGO_ENV=prod
DJANGO_DEBUG=False
DJANGO_SETTINGS_MODULE=saeedpay.settings.prod
DJANGO_SECRET_KEY=change-me-very-long-random
DJANGO_ALLOWED_HOSTS=saeedpay.example.com
DJANGO_CSRF_TRUSTED_ORIGINS=https://saeedpay.example.com
DJANGO_TIME_ZONE=Asia/Tehran

DJANGO_SECURE_SSL_REDIRECT=True
DJANGO_SECURE_HSTS_SECONDS=31536000
DJANGO_SECURE_HSTS_INCLUDE_SUBDOMAINS=True
DJANGO_SECURE_HSTS_PRELOAD=True

# Database
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_DB=saeedpay
POSTGRES_USER=saeedpay
POSTGRES_PASSWORD=change-me

# Brand / service naming
SERVICE_NAME=SAEEDPAY
SERVICE_NAME_FA=سعید پی

# URL prefix for all app routes (without slashes)
URL_PREFIX=saeedpay

# Redis / Celery
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_BROKER_DB=0
REDIS_BACKEND_DB=1
REDIS_CACHE_DB=2
CACHE_TIMEOUT=300

# Static
STATIC_ROOT=/app/staticfiles

# CORS
CORS_ALLOWED_ORIGINS=https://saeedpay.example.com

# CAS
CAS_PUBLICKEY_URL=http://erp.ag/cas/static/public_key.pem
CAS_URL=http://erp.ag/cas
CAS_DEBUG=False
CAS_SAME_ORIGIN=False

FRONTEND_BASE_URL=http://localhost:3000/
# Logging
LOG_LEVEL=INFO
LOG_JSON=True

# OTP
OTP_EXPIRY_MINUTES=5
OTP_RESEND_COOLDOWN_SEC=60
OTP_MAX_ATTEMPTS=5
OTP_DAILY_ISSUE_CAP_PER_IDENTITY=10
OTP_CODE_LENGTH=6

# SMS / OTP
OTP_SMS_BACKEND=lib.erp_base.otp.sms.kavenegar_backend.KavenegarBackend
KAVENEGAR_API_KEY=change-me
KAVENEGAR_NUMBER=999999999

# Card validator
CARD_VALIDATOR_MOCK=False

# KYC
KYC_IDENTITY_BASE_URL=https://sandbox.vidaverify.ir:9091
KYC_IDENTITY_TIMEOUT=30
KYC_IDENTITY_TOKEN_SKEW_SECONDS=30

KYC_VIDEO_SUBMIT_MAX_RETRIES=3
KYC_VIDEO_SUBMIT_RETRY_DELAY=60
KYC_VIDEO_CHECK_MAX_RETRIES=6
KYC_VIDEO_CHECK_RETRY_DELAY=30
KYC_SHAHKAR_MAX_RETRIES=3
KYC_SHAHKAR_RETRY_DELAY=60

KIAHOOSHAN_USERNAME=
KIAHOOSHAN_PASSWORD=
KIAHOOSHAN_ORGNAME=
KIAHOOSHAN_ORGNATIONALCODE=

KYC_VIDEO_RETENTION_MODE=approved_only
KYC_VIDEO_RETENTION_DAYS_APPROVED=permanent
KYC_VIDEO_RETENTION_DAYS_REJECTED=7
KYC_VIDEO_STORAGE_PREFIX=kyc_videos/

# Credit
CREDIT_DEFAULT_APPROVED_LIMIT=5000000

# reCAPTCHA
RECAPTCHA_SECRET_KEY=change-me

# Chatbot
LLM_BASE_URL=http://localhost:8001
CHATBOT_HISTORY_LIMIT=4
CHATBOT_SESSION_LIMIT=2


OTP_SMS_BACKEND=erp_base.otp.sms.kavenegar_backend.KavenegarBackend